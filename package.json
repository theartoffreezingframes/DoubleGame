{
  "name": "double-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DOUBLE GAME — cinematic open-world narrative game set in fictionalized Hyderabad. Milestone 1 vertical slice.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --experimental-transform-types tests/logic.test.mts",
    "test:runtime": "node --experimental-transform-types tests/runtime.test.mts",
    "test:all": "node --experimental-transform-types tests/logic.test.mts && node --experimental-transform-types tests/runtime.test.mts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
